[Unit]
Description=Backup semanal do Tardis
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
EnvironmentFile=-/etc/tardis-backup.env
WorkingDirectory=/home/vamg/Desktop/services/Tardis-source-2026
ExecStart=/home/vamg/Desktop/services/Tardis-source-2026/scripts/tardis-backup.sh
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=infinity
StandardOutput=journal
StandardError=journal
